<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PMDM_P1_GameApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Colors principals -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Fons del menú seleccionat -->
        <item name="colorPrimaryContainer">#333333</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Superfícies i fons (Això controla el fons del menú) -->
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Altres colors de superfície -->
        <item name="colorSurfaceVariant">#1E1E1E</item>
        <item name="colorOnSurfaceVariant">#AAAAAA</item>
    </style>

    <style name="Theme.PMDM_P1_GameApp" parent="Base.Theme.PMDM_P1_GameApp" />
</resources>
